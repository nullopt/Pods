<UserControl
    x:Class="Pods.App.Views.DevicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:devices="using:Pods.App.Devices"
    xmlns:views="using:Pods.App.Views">

    <Grid Background="{ThemeResource PodsPageBackground}">
        <ScrollViewer>
            <StackPanel Padding="20,44,20,20" Spacing="16">
                <TextBlock x:Uid="DevicesTitle" FontSize="30" FontWeight="Bold"
                           Foreground="{ThemeResource PodsPrimaryText}" />

                <TextBlock x:Uid="DevicesEmpty" TextWrapping="Wrap" FontSize="15"
                           Foreground="{ThemeResource PodsSecondaryText}"
                           Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

                <TextBlock x:Uid="DevicesBluetoothOff" TextWrapping="Wrap" FontSize="15"
                           Foreground="{ThemeResource PodsSecondaryText}"
                           Visibility="{x:Bind ViewModel.IsAdapterUnavailable, Mode=OneWay}" />

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="devices:DeviceCardViewModel">
                            <Border Background="{ThemeResource PodsCardBackground}" CornerRadius="18" Padding="20,16,20,18">
                                <StackPanel Spacing="16">
                                    <views:TurntableView HorizontalAlignment="Center"
                                                         Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                                         Sheet="{x:Bind TurntableSheet, Mode=OneWay}" />
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource PodsPrimaryText}" />
                                        <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="13"
                                                   Foreground="{ThemeResource PodsSecondaryText}" />
                                    </StackPanel>

                                    <Grid>
                                        <Button x:Uid="CardConnect" Style="{StaticResource AccentButtonStyle}"
                                                Command="{x:Bind ConnectCommand}"
                                                IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                                                Visibility="{x:Bind ShowConnect, Mode=OneWay}" />
                                        <Button x:Uid="CardDisconnect"
                                                Command="{x:Bind DisconnectCommand}"
                                                IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                                                Visibility="{x:Bind ShowDisconnect, Mode=OneWay}" />
                                    </Grid>

                                    <ItemsRepeater ItemsSource="{x:Bind Batteries}" Opacity="{x:Bind ContentOpacity, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="20" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="devices:BatteryViewModel">
                                                <StackPanel Width="64" Spacing="6">
                                                    <Grid Width="56" Height="56" HorizontalAlignment="Center">
                                                        <ProgressRing IsIndeterminate="False" Minimum="0" Maximum="100"
                                                                      Width="56" Height="56"
                                                                      Value="{x:Bind Value, Mode=OneWay}"
                                                                      Background="{ThemeResource PodsRingTrack}"
                                                                      Foreground="{ThemeResource PodsGreen}"
                                                                      Visibility="{x:Bind IsNormal, Mode=OneWay}" />
                                                        <ProgressRing IsIndeterminate="False" Minimum="0" Maximum="100"
                                                                      Width="56" Height="56"
                                                                      Value="{x:Bind Value, Mode=OneWay}"
                                                                      Background="{ThemeResource PodsRingTrack}"
                                                                      Foreground="{ThemeResource PodsRed}"
                                                                      Visibility="{x:Bind IsLow, Mode=OneWay}" />
                                                        <FontIcon Glyph="&#xE945;" FontSize="18"
                                                                  Foreground="{ThemeResource PodsGreen}"
                                                                  Visibility="{x:Bind IsCharging, Mode=OneWay}" />
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{ThemeResource PodsPrimaryText}" />
                                                    <TextBlock Text="{x:Bind Label}" FontSize="12" HorizontalAlignment="Center"
                                                               Foreground="{ThemeResource PodsSecondaryText}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

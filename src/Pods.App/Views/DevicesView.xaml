<UserControl
    x:Class="Pods.App.Views.DevicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:devices="using:Pods.App.Devices"
    xmlns:views="using:Pods.App.Views"
    FontFamily="{StaticResource PodsFont}">

    <UserControl.Resources>
        <!--
            Low battery sliders, after Apple's guidance: a thick rounded track that fills up to the thumb in the
            Windows accent colour, a large white thumb, a dot for each 5% step, labels only at the ends, and the
            value in a tooltip while the thumb is held or pointed at. A custom template: the default one cannot
            take this shape.
        -->
        <views:PercentConverter x:Key="PercentConverter" />
        <Style x:Key="PodsSliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#F2F2F4" BorderBrush="#33000000" BorderThickness="0.5" CornerRadius="11" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PodsThresholdSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="5" />
            <Setter Property="Maximum" Value="50" />
            <Setter Property="StepFrequency" Value="5" />
            <Setter Property="SnapsTo" Value="StepValues" />
            <Setter Property="ThumbToolTipValueConverter" Value="{StaticResource PercentConverter}" />
            <Setter Property="IsFocusEngagementEnabled" Value="False" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="HorizontalTemplate" Background="Transparent" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="6" RadiusX="3" RadiusY="3"
                                       Fill="{ThemeResource PodsRingTrack}" />
                            <!-- The slider sizes this to the thumb's position; it only sets the layout. -->
                            <Rectangle x:Name="HorizontalDecreaseRect" Height="6" Fill="Transparent" />
                            <!-- The visible fill spans up to the thumb's far edge, so it meets the thumb. -->
                            <Rectangle Grid.ColumnSpan="2" Height="6" RadiusX="3" RadiusY="3">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="28" Height="22"
                                   Style="{StaticResource PodsSliderThumb}" AutomationProperties.AccessibilityView="Raw"
                                   DataContext="{TemplateBinding Value}" />
                            <views:TickDots Grid.Row="1" Grid.ColumnSpan="3" Count="10" Inset="14"
                                            Fill="{ThemeResource PodsSecondaryText}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A small round, transparent button holding one glyph (info, back, settings). -->
        <Style x:Key="PodsIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource PodsSecondaryText}" />
        </Style>

        <!-- A 44 px battery ring with its percentage below, as on the iPhone case-open card. -->
        <DataTemplate x:Key="RingTemplate" x:DataType="devices:BatteryViewModel">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Grid Width="44" Height="44" HorizontalAlignment="Center">
                    <ProgressRing IsIndeterminate="False" Minimum="0" Maximum="100" Width="44" Height="44"
                                  Value="{x:Bind Value, Mode=OneWay}"
                                  Background="{ThemeResource PodsRingTrack}" Foreground="{ThemeResource PodsGreen}"
                                  Visibility="{x:Bind IsNormal, Mode=OneWay}" />
                    <ProgressRing IsIndeterminate="False" Minimum="0" Maximum="100" Width="44" Height="44"
                                  Value="{x:Bind Value, Mode=OneWay}"
                                  Background="{ThemeResource PodsRingTrack}" Foreground="{ThemeResource PodsRed}"
                                  Visibility="{x:Bind IsLow, Mode=OneWay}" />
                    <!-- Solid charging bolt (our own shape). -->
                    <Path Data="M7.5,0 L0.5,9.5 L5.5,9.5 L4.5,17 L11.5,6.5 L6.5,6.5 Z" Width="12" Height="17" Stretch="Uniform" Fill="{ThemeResource PodsGreen}"
                          StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{x:Bind IsCharging, Mode=OneWay}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <Grid Width="16" Height="16" VerticalAlignment="Center" Visibility="{x:Bind HasLetter}">
                        <Ellipse Fill="{ThemeResource PodsPrimaryText}" />
                        <TextBlock Text="{x:Bind Letter}" FontSize="10" FontWeight="Bold" TextLineBounds="Tight"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource PodsCardBackground}" />
                    </Grid>
                    <!-- Case glyph: rounded body, lid seam and catch. -->
                    <Grid Width="22" Height="15" VerticalAlignment="Center" Visibility="{x:Bind HasCaseBadge}">
                        <Rectangle RadiusX="4" RadiusY="4" Fill="{ThemeResource PodsPrimaryText}" />
                        <Rectangle Height="1.2" Margin="0,5,0,0" VerticalAlignment="Top"
                                   Fill="{ThemeResource PodsCardBackground}" />
                        <Rectangle Width="8" Height="2.6" RadiusX="1.3" RadiusY="1.3" Margin="0,4.3,0,0"
                                   VerticalAlignment="Top" Fill="{ThemeResource PodsCardBackground}" />
                    </Grid>
                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{ThemeResource PodsPrimaryText}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <!-- The flyout: a header, then device tiles two to a row; its back holds the app settings. -->
    <views:FlipPanel IsFlipped="{x:Bind ViewModel.IsSettingsShown, Mode=OneWay}">
     <views:FlipPanel.Front>
    <StackPanel Background="{ThemeResource PodsPageBackground}" Padding="12" Spacing="10" MinWidth="240">
        <Grid Margin="4,0,-6,0">
            <TextBlock x:Uid="DevicesTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{ThemeResource PodsPrimaryText}" />
            <Button x:Uid="FlyoutSettings" HorizontalAlignment="Right" Style="{StaticResource PodsIconButton}"
                    Command="{x:Bind ViewModel.ToggleSettingsCommand}">
                <FontIcon Glyph="&#xE713;" FontSize="15" />
            </Button>
        </Grid>

        <TextBlock x:Uid="DevicesEmpty" TextWrapping="Wrap" FontSize="13" MaxWidth="320" Margin="4,0,4,4"
                   HorizontalAlignment="Left" Foreground="{ThemeResource PodsSecondaryText}"
                   Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

        <TextBlock x:Uid="DevicesBluetoothOff" TextWrapping="Wrap" FontSize="13" MaxWidth="320" Margin="4,0,4,4"
                   HorizontalAlignment="Left" Foreground="{ThemeResource PodsSecondaryText}"
                   Visibility="{x:Bind ViewModel.IsAdapterUnavailable, Mode=OneWay}" />

        <!-- The grid layout gives every item the first one's size, so tiles have a fixed size. -->
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards}">
            <ItemsRepeater.Layout>
                <UniformGridLayout MaximumRowsOrColumns="2" MinColumnSpacing="10" MinRowSpacing="10" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="devices:DeviceCardViewModel">
                  <views:FlipPanel IsFlipped="{x:Bind IsFlipped, Mode=OneWay}">
                   <views:FlipPanel.Front>
                    <Grid Width="216" Height="256" Padding="12" RowSpacing="8" CornerRadius="14"
                          Background="{ThemeResource PodsCardBackground}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button x:Uid="TileSettings" Grid.RowSpan="3" Canvas.ZIndex="1" Margin="0,-6,-6,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource PodsIconButton}"
                                Command="{x:Bind FlipCommand}">
                            <FontIcon Glyph="&#xE946;" FontSize="14" />
                        </Button>

                        <StackPanel Spacing="1" Margin="22,0,22,0">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource PodsPrimaryText}" />
                            <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="12" TextAlignment="Center"
                                       Foreground="{ThemeResource PodsSecondaryText}" />
                        </StackPanel>

                        <!-- Earbuds and case side by side, each over its rings. -->
                        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="12"
                              Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                              Visibility="{x:Bind IsSplit, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="10">
                                <Border Height="70" HorizontalAlignment="Center">
                                    <views:TurntableView Part="Left" FrameHeight="70" Sheet="{x:Bind Sheet, Mode=OneWay}"
                                                         IsSpinning="{x:Bind IsSpinning, Mode=OneWay}" />
                                </Border>
                                <Grid HorizontalAlignment="Center">
                                    <ContentControl Content="{x:Bind Buds}" ContentTemplate="{StaticResource RingTemplate}"
                                                    Visibility="{x:Bind ShowCombinedBuds, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                Visibility="{x:Bind ShowSeparateBuds, Mode=OneWay}">
                                        <ContentControl Content="{x:Bind Left}" ContentTemplate="{StaticResource RingTemplate}" />
                                        <ContentControl Content="{x:Bind Right}" ContentTemplate="{StaticResource RingTemplate}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="10">
                                <Border Height="70" HorizontalAlignment="Center">
                                    <views:TurntableView Part="Right" FrameHeight="70" Sheet="{x:Bind Sheet, Mode=OneWay}"
                                                         IsSpinning="{x:Bind IsSpinning, Mode=OneWay}" />
                                </Border>
                                <ContentControl Content="{x:Bind Case}" ContentTemplate="{StaticResource RingTemplate}"
                                                HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Whole headphones (or a model without split artwork) over their rings. -->
                        <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                    Visibility="{x:Bind IsWhole, Mode=OneWay}">
                            <Border Height="70" HorizontalAlignment="Center">
                                <views:TurntableView FrameHeight="70" Sheet="{x:Bind Sheet, Mode=OneWay}"
                                                     IsSpinning="{x:Bind IsSpinning, Mode=OneWay}" />
                            </Border>
                            <ContentControl Content="{x:Bind Single}" ContentTemplate="{StaticResource RingTemplate}"
                                            HorizontalAlignment="Center"
                                            Visibility="{x:Bind IsSingleBattery, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"
                                        Visibility="{x:Bind HasPodRings, Mode=OneWay}">
                                <ContentControl Content="{x:Bind Left}" ContentTemplate="{StaticResource RingTemplate}" />
                                <ContentControl Content="{x:Bind Right}" ContentTemplate="{StaticResource RingTemplate}" />
                                <ContentControl Content="{x:Bind Case}" ContentTemplate="{StaticResource RingTemplate}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="2" HorizontalAlignment="Center">
                            <Button x:Uid="CardConnect" Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ConnectCommand}"
                                    IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                                    Visibility="{x:Bind ShowConnect, Mode=OneWay}" />
                            <Button x:Uid="CardDisconnect"
                                    Command="{x:Bind DisconnectCommand}"
                                    IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                                    Visibility="{x:Bind ShowDisconnect, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                   </views:FlipPanel.Front>

                   <!-- The back: this device's settings. -->
                   <views:FlipPanel.Back>
                    <Grid Width="216" Height="256" Padding="12" RowSpacing="12" CornerRadius="14"
                          Background="{ThemeResource PodsCardBackground}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="4" Margin="-6,-6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Uid="TileBack" Style="{StaticResource PodsIconButton}" Command="{x:Bind FlipCommand}">
                                <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            </Button>
                            <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource PodsPrimaryText}" />
                        </Grid>
                        <ScrollViewer Grid.Row="1">
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="TileLowBattery" FontSize="13" Foreground="{ThemeResource PodsSecondaryText}" />
                                <TextBlock Text="{x:Bind ThresholdText, Mode=OneWay}" FontSize="15"
                                           Foreground="{ThemeResource PodsPrimaryText}" />
                                <StackPanel>
                                    <Slider Style="{StaticResource PodsThresholdSlider}" Value="{x:Bind Threshold, Mode=TwoWay}" />
                                    <Grid Margin="0,2,0,0">
                                        <TextBlock Text="5%" FontSize="11" Foreground="{ThemeResource PodsSecondaryText}" />
                                        <TextBlock Text="50%" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource PodsSecondaryText}" />
                                    </Grid>
                                </StackPanel>
                                <HyperlinkButton x:Uid="TileUseDefault" Padding="0" Command="{x:Bind UseAppDefaultCommand}"
                                                 Visibility="{x:Bind HasOwnThreshold, Mode=OneWay}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                   </views:FlipPanel.Back>
                  </views:FlipPanel>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
     </views:FlipPanel.Front>

     <views:FlipPanel.Back>
    <StackPanel Background="{ThemeResource PodsPageBackground}" Padding="12" Spacing="10">
        <Grid ColumnSpacing="4" Margin="-6,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Uid="FlyoutBack" Style="{StaticResource PodsIconButton}" Command="{x:Bind ViewModel.ToggleSettingsCommand}">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <TextBlock x:Uid="SettingsTitle" Grid.Column="1" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{ThemeResource PodsPrimaryText}" />
        </Grid>
        <StackPanel Spacing="6" Padding="12" CornerRadius="14" Background="{ThemeResource PodsCardBackground}">
            <Grid>
                <TextBlock x:Uid="AppLowBattery" FontSize="13" Foreground="{ThemeResource PodsSecondaryText}" />
                <TextBlock Text="{x:Bind ViewModel.AppSettings.ThresholdText, Mode=OneWay}" FontSize="13" HorizontalAlignment="Right"
                           Foreground="{ThemeResource PodsPrimaryText}" />
            </Grid>
            <StackPanel>
                <Slider Style="{StaticResource PodsThresholdSlider}" Value="{x:Bind ViewModel.AppSettings.Threshold, Mode=TwoWay}" />
                <Grid Margin="0,2,0,0">
                    <TextBlock Text="5%" FontSize="11" Foreground="{ThemeResource PodsSecondaryText}" />
                    <TextBlock Text="50%" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource PodsSecondaryText}" />
                </Grid>
            </StackPanel>
            <TextBlock x:Uid="AppLogLevel" FontSize="13" Margin="0,8,0,0" Foreground="{ThemeResource PodsSecondaryText}" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.AppSettings.LogLevels}"
                      SelectedIndex="{x:Bind ViewModel.AppSettings.SelectedLogLevelIndex, Mode=TwoWay}" />
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.AppSettings.Version}" FontSize="12" Margin="4,0,4,0"
                   Foreground="{ThemeResource PodsSecondaryText}" />
    </StackPanel>
     </views:FlipPanel.Back>
    </views:FlipPanel>
</UserControl>

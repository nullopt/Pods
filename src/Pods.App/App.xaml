<Application
    x:Class="Pods.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Apple-style palette (iOS system colours); own values, no Apple assets. -->
            <!-- Inter (SIL Open Font License, Assets/Fonts/Inter-OFL.txt): an open font close to Apple's system look. -->
            <FontFamily x:Key="PodsFont">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>

            <!-- A small round, transparent button holding one glyph (info, back, settings). -->
            <Style x:Key="PodsIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource PodsSecondaryText}" />
            </Style>

            <!-- Every switch in the app is a settings row's: no reserved width for On/Off text. -->
            <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>

            <!-- A settings row's switch: no On/Off text, at the row's right edge, rows kept short. -->
            <Style x:Key="PodsRowToggle" TargetType="ToggleSwitch">
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Grid.Column" Value="1" />
                <Setter Property="Margin" Value="0,-10,0,-10" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- A settings row's label. -->
            <Style x:Key="PodsRowLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{ThemeResource PodsPrimaryText}" />
            </Style>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PodsPageBackground" Color="#F2F2F7" />
                    <SolidColorBrush x:Key="PodsCardBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PodsPrimaryText" Color="#000000" />
                    <SolidColorBrush x:Key="PodsSecondaryText" Color="#8A8A8E" />
                    <SolidColorBrush x:Key="PodsRingTrack" Color="#E5E5EA" />
                    <SolidColorBrush x:Key="PodsGreen" Color="#34C759" />
                    <SolidColorBrush x:Key="PodsRed" Color="#FF3B30" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PodsPageBackground" Color="#000000" />
                    <SolidColorBrush x:Key="PodsCardBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="PodsPrimaryText" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PodsSecondaryText" Color="#8D8D93" />
                    <SolidColorBrush x:Key="PodsRingTrack" Color="#38383A" />
                    <SolidColorBrush x:Key="PodsGreen" Color="#30D158" />
                    <SolidColorBrush x:Key="PodsRed" Color="#FF453A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

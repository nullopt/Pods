<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pods.App.Tray.TrayCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tray="using:Pods.App.Tray"
    xmlns:views="using:Pods.App.Views"
    FontFamily="{StaticResource PodsFont}">

    <Border Background="{ThemeResource PodsCardBackground}" Padding="20,18">
        <Grid>
            <TextBlock x:Uid="TrayNoHeadphones" FontSize="14" Foreground="{ThemeResource PodsSecondaryText}"
                       Visibility="{x:Bind Card.IsEmpty, Mode=OneWay}" />
            <ItemsControl x:Name="RingList" ItemsSource="{x:Bind Card.Rings, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="18" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="tray:TrayRingViewModel">
                        <StackPanel Width="90" Spacing="6">
                            <Grid Width="56" Height="56" HorizontalAlignment="Center">
                                <ProgressRing IsIndeterminate="False" Minimum="0" Maximum="100" Width="56" Height="56"
                                              Value="{x:Bind Value}" Background="{ThemeResource PodsRingTrack}"
                                              Foreground="{ThemeResource PodsGreen}" Visibility="{x:Bind IsNormal}" />
                                <ProgressRing IsIndeterminate="False" Minimum="0" Maximum="100" Width="56" Height="56"
                                              Value="{x:Bind Value}" Background="{ThemeResource PodsRingTrack}"
                                              Foreground="{ThemeResource PodsRed}" Visibility="{x:Bind IsLow}" />
                                <Border Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <views:TurntableView Part="{x:Bind Part}" Sheet="{x:Bind Sheet}" FrameHeight="30" />
                                </Border>
                                <!-- Charging bolt over the top of the ring, as in the macOS widget. -->
                                <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="{ThemeResource PodsGreen}"
                                          VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-6,0,0"
                                          Visibility="{x:Bind IsCharging}" />
                            </Grid>
                            <TextBlock Text="{x:Bind Text}" FontSize="17" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource PodsPrimaryText}" />
                            <TextBlock Text="{x:Bind Label}" FontSize="12" HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="90"
                                       Foreground="{ThemeResource PodsSecondaryText}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
